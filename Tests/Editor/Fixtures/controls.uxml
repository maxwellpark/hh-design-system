<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hh="HootonHeroics.DesignSystem">
    <hh:HHProgressBar name="progress" title="Loading" value="40" />
    <hh:HHButton name="ghost" text="Back" ghost="true" />
    <hh:HHButton name="plain" text="Play" />
    <hh:HHToggle name="toggle" label="Music" value="true" />
    <hh:HHSlider name="slider" label="Volume" low-value="0" high-value="1" value="0.5" />
    <hh:HHDropdown name="dropdown" label="Quality" choices="Low,High" index="1" />
    <hh:HHTextField name="text-field" label="Name" value="Northwind" />
    <hh:HHIconButton name="icon-button" tooltip="Settings" />
    <hh:HHBadge name="badge" count="120" tone="Pink" />
    <hh:HHBadge name="dot" dot="true" count="4" />
    <hh:HHDialog name="dialog" title="Quit?" require-choice="true">
        <ui:Label name="dialog-body" text="Unsaved progress will be lost." />
    </hh:HHDialog>
    <hh:HHProgressBar name="pink-progress" value="10" tone="Pink" />
    <hh:HHSegmentedBar name="health" segments="4" filled="3" tone="Pink" />
    <hh:HHSegmentedBar name="ammo" filled="8" segments="10" />
    <hh:HHToastStack name="toasts" max-visible="2" />
    <hh:HHToast name="toast" text="Saved" tone="Success" />
    <hh:HHScrollView name="scroll">
        <ui:Label name="scroll-content" text="Long content" />
    </hh:HHScrollView>
    <hh:HHListView name="list" fixed-item-height="36" />
    <hh:HHTabs name="tabs">
        <ui:Tab name="audio" label="Audio" />
        <ui:Tab name="video" label="Video" />
    </hh:HHTabs>
    <hh:HHCard name="card" title="Audio">
        <hh:HHToggle name="card-toggle" label="Music" />
    </hh:HHCard>
    <hh:HHRadioGroup name="radio" label="Difficulty" choices="Easy,Normal,Hard" value="1" />
</ui:UXML>
