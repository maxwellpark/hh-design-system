/* Components, all styled through the tokens (var(--hh-*)) so a theme swap restyles everything. */
.hh-card {
    background-color: var(--hh-color-surface);
    border-radius: var(--hh-radius-lg);
    padding: var(--hh-space-6);
}

.hh-title {
    color: var(--hh-color-text);
    font-size: var(--hh-font-size-xl);
    -unity-font-style: bold;
}

.hh-text {
    color: var(--hh-color-text);
    font-size: var(--hh-font-size-md);
}

.hh-text-dim {
    color: var(--hh-color-text-dim);
    font-size: var(--hh-font-size-md);
}

.hh-button {
    background-color: var(--hh-color-violet);
    color: var(--hh-color-text);
    border-radius: var(--hh-radius-md);
    padding: var(--hh-space-3) var(--hh-space-6);
    /* Always 2px, transparent until focused, so focus doesn't shift the layout */
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    -unity-font-style: bold;
    transition-duration: 0.12s;
}

.hh-button:hover {
    background-color: var(--hh-color-violet-light);
}

/* Unity's .unity-button:hover:active outranks .hh-button:hover, so pressed needs its own rule */
.hh-button:hover:active {
    background-color: var(--hh-color-violet);
}

.hh-button:focus {
    border-color: var(--hh-color-focus);
}

.hh-button:disabled {
    opacity: 0.4;
}

/* Two classes so ghost outranks .hh-button:hover, which paints violet-light behind violet-light text */
.hh-button.hh-button--ghost {
    background-color: var(--hh-color-violet-ghost);
    color: var(--hh-color-violet-light);
}

.hh-button.hh-button--ghost:hover {
    background-color: var(--hh-color-violet-ghost-hover);
}

.hh-button.hh-button--ghost:hover:active {
    background-color: var(--hh-color-violet-ghost);
}

/* The title sits above the bar, on the card, since no text colour reads on both the fill and the track */
.hh-progress-bar {
    padding-top: var(--hh-space-6);
}

.hh-progress-bar .unity-progress-bar__background {
    background-color: var(--hh-color-track);
    border-width: 0;
    border-radius: var(--hh-radius-sm);
    min-height: var(--hh-space-3);
}

.hh-progress-bar .unity-progress-bar__progress {
    background-color: var(--hh-color-teal);
    border-width: 0;
    border-radius: var(--hh-radius-sm);
}

.hh-progress-bar .unity-progress-bar__title-container {
    top: auto;
    bottom: 100%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: flex-end;
    padding-bottom: var(--hh-space-1);
}

.hh-progress-bar .unity-progress-bar__title {
    color: var(--hh-color-text);
    font-size: var(--hh-font-size-sm);
    -unity-font-style: bold;
    -unity-text-align: lower-left;
}

/* Form controls: labels, then each control's parts as Unity names them */
.hh-toggle .unity-base-field__label,
.hh-slider .unity-base-field__label,
.hh-dropdown .unity-base-field__label,
.hh-text-field .unity-base-field__label {
    color: var(--hh-color-text);
    font-size: var(--hh-font-size-md);
}

.hh-toggle:disabled,
.hh-slider:disabled,
.hh-dropdown:disabled,
.hh-text-field:disabled {
    opacity: 0.4;
}

.hh-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    background-color: var(--hh-color-bg);
    border-width: 2px;
    border-color: var(--hh-color-violet-light);
    border-radius: var(--hh-radius-sm);
}

.hh-toggle:hover .unity-toggle__checkmark {
    border-color: var(--hh-color-text);
}

.hh-toggle:checked .unity-toggle__checkmark {
    background-color: var(--hh-color-violet);
    border-color: var(--hh-color-violet);
    -unity-background-image-tint-color: var(--hh-color-text);
}

.hh-toggle:focus .unity-toggle__checkmark {
    border-color: var(--hh-color-focus);
}

.hh-slider .unity-base-slider__tracker {
    background-color: var(--hh-color-track);
    border-width: 0;
    border-radius: var(--hh-radius-sm);
}

.hh-slider .unity-base-slider__dragger {
    background-color: var(--hh-color-teal);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--hh-radius-sm);
}

.hh-slider:focus .unity-base-slider__dragger {
    border-color: var(--hh-color-text);
}

.hh-dropdown .unity-base-popup-field__input,
.hh-text-field .unity-base-text-field__input {
    background-color: var(--hh-color-bg);
    color: var(--hh-color-text);
    border-width: 2px;
    border-color: var(--hh-color-track);
    border-radius: var(--hh-radius-sm);
    padding: var(--hh-space-1) var(--hh-space-2);
}

.hh-dropdown .unity-base-popup-field__text {
    color: var(--hh-color-text);
}

.hh-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--hh-color-violet-light);
}

.hh-dropdown:hover .unity-base-popup-field__input,
.hh-text-field:hover .unity-base-text-field__input {
    border-color: var(--hh-color-violet-light);
}

.hh-dropdown:focus .unity-base-popup-field__input,
.hh-text-field:focus .unity-base-text-field__input {
    border-color: var(--hh-color-focus);
}
