/* The single source of the look; HHTheme.cs mirrors it, enforced by Tools~/check.mjs */
:root {
    --hh-color-bg: #0E0F20;
    --hh-color-surface: #191B38;
    --hh-color-track: #2E3166;
    --hh-color-violet: #8257FF;
    --hh-color-violet-light: #A78BFA;
    --hh-color-violet-ghost: rgba(130, 87, 255, 0.14);
    --hh-color-violet-ghost-hover: rgba(130, 87, 255, 0.22);
    --hh-color-teal: #45D6C4;
    --hh-color-pink: #FF5C8A;
    --hh-color-peach: #FFB25C;
    --hh-color-text: #F3F3FB;
    --hh-color-text-dim: rgba(243, 243, 251, 0.62);
    --hh-color-focus: #45D6C4;

    --hh-space-1: 4px;
    --hh-space-2: 8px;
    --hh-space-3: 12px;
    --hh-space-4: 16px;
    --hh-space-6: 24px;

    --hh-radius-sm: 6px;
    --hh-radius-md: 12px;
    --hh-radius-lg: 20px;

    --hh-font-size-sm: 12px;
    --hh-font-size-md: 14px;
    --hh-font-size-lg: 18px;
    --hh-font-size-xl: 28px;

    --hh-duration-fast: 0.12s;
    --hh-duration-normal: 0.2s;
    --hh-easing-standard: ease-out;
}
