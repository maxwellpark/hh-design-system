/* Unity opens dropdown lists at the panel root, outside any document, so only hh-theme.tss reaches them */
.unity-base-dropdown__container-outer {
    border-width: 1px;
    border-color: var(--hh-color-track);
    border-radius: var(--hh-radius-md);
    background-color: var(--hh-color-surface);
}

.unity-base-dropdown__container-inner {
    padding: var(--hh-space-1) 0;
}

.unity-base-dropdown__item {
    padding: var(--hh-space-1) var(--hh-space-3);
}

.unity-base-dropdown__item:hover {
    background-color: var(--hh-color-track);
}

.unity-base-dropdown__label {
    color: var(--hh-color-text);
    font-size: var(--hh-font-size-md);
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--hh-color-teal);
}

.unity-base-dropdown__separator {
    height: 1px;
    margin: var(--hh-space-1) 0;
    background-color: var(--hh-color-track);
}
